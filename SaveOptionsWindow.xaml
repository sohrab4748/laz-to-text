<Window x:Class="LAS_to_TEXT.SaveOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Options" Height="600" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Header Options" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="chkSaveHeader" Content="Save Header to Separate File" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Select Columns to Save" Grid.Row="1" Margin="0,0,0,10">
            <ListBox x:Name="lstColumns" SelectionMode="Multiple" Height="150" Margin="5">
            </ListBox>
        </GroupBox>

        <GroupBox Header="Column Order" Grid.Row="2" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lstColumnOrder" AllowDrop="True" Drop="lstColumnOrder_Drop" Grid.Row="0" Margin="5" Height="170" ScrollViewer.VerticalScrollBarVisibility="Auto">
                </ListBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
                    <Button Content="Move Up" Click="MoveUp_Click" Margin="5" Height="30" Width="100"/>
                    <Button Content="Move Down" Click="MoveDown_Click" Margin="5" Height="30" Width="100"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Button Content="Save with Options" Grid.Row="3" Width="120" Height="30" Click="SaveWithOptions_Click" HorizontalAlignment="Right"/>
    </Grid>
</Window>