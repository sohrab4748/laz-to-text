<Window x:Class="LAS_to_TEXT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAS_to_TEXT"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="LAS To Text File Converter" Height="650" Width="900" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="800" Name="toolB">
            <Button Name="quit" ToolTip="Exit From App" Click="quit_Click">
                <Image Source="img/quit.png" Width="24" Height="24" />
            </Button>
            <Button Name="restart" ToolTip="Restart App" Click="restart_Click">
                <Image Source="img/reset.png" Width="24" Height="24" />
            </Button>
            <Button Name="aboutus" ToolTip="About Us" Click="aboutus_Click">
                <Image Source="img/aboutus.jpg" Width="24" Height="24" />
            </Button>
            <Button ToolTip="Visit Website" Click="VisitWebsite_Click">
                <Image Source="/img/link.png" Width="24" Height="24"/>
            </Button>
            <Button x:Name="linkProducts" ToolTip="Check Products on Website" Click="VisitProducts_Click">
                <Image Source="/img/products.jpg" Width="24" Height="24" />
            </Button>
            <Separator/>
            <Grid Margin="20,2" Width="500">
                <ProgressBar x:Name="progress" Value="{Binding ProgressValue}"/>
                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="Black"
                   FontSize="14"
                   FontWeight="Bold" />
            </Grid>
            <Separator/>
        </ToolBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="19*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <Button x:Name="sellectFile" Content="Open LAS File" Width="120" Height="30" Margin="10,10,10,5" Click="sellectFile_Click"/>
                <Button x:Name="saveAll" IsEnabled="False" Content="Save All" Width="120" Height="30" Margin="10,5" Click="saveAll_Click"/>
                <Button x:Name="saveOption" IsEnabled="False" Content="Save with Options" Width="120" Height="30" Margin="10,5" Click="saveOption_Click"/>
            </StackPanel>
            <GroupBox Header="Header" Margin="10,5" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBox x:Name="attTxt" Width="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Data">
            <local:TooltipDataGrid x:Name="dg" Margin="20,5" ItemsSource="{Binding}" AutoGenerateColumns="True" AutoGeneratingColumn="Dg_AutoGeneratingColumn"  CanUserAddRows="False" IsReadOnly="True" AlternatingRowBackground="LightGray">
            </local:TooltipDataGrid>
        </GroupBox>
    </Grid>

</Window>
